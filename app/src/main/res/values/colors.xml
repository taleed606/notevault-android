<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Primary: soft teal - used for the app bar, filled buttons, focused fields -->
    <color name="color_primary">#6FA8A3</color>
    <color name="color_primary_variant">#4F8480</color>
    <color name="color_on_primary">#FFFFFF</color>

    <!-- Secondary: soft mint green - used for secondary actions and accents -->
    <color name="color_secondary">#8FCBA6</color>
    <color name="color_secondary_variant">#6BA684</color>
    <color name="color_on_secondary">#1B3A2E</color>

    <!-- Backgrounds - very light blue-green wash, and white cards on top of it -->
    <color name="color_background">#EAF4F1</color>
    <color name="color_surface">#FFFFFF</color>
    <color name="color_on_surface">#26332F</color>
    <color name="drawer_selected_background">#E7F2F1</color>

    <!-- Gradient stops used for screen backgrounds -->
    <color name="gradient_top">#DFF0EC</color>
    <color name="gradient_bottom">#CFEAE0</color>

    <!-- Text -->
    <color name="color_text_primary">#26332F</color>
    <color name="color_text_secondary">#6B7C7A</color>
    <color name="color_hint">#94A6A3</color>

    <!-- A muted coral-red that still reads clearly as "error" without
         clashing with the pastel palette -->
    <color name="color_error">#D9756B</color>
    <color name="color_on_error">#FFFFFF</color>

</resources>
